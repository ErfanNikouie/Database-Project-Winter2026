DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

DB_ENGINE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hrms
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONN_MAX_AGE=60

HRMS_ROOT_USERNAME=root
HRMS_ROOT_PASSWORD=ChangeMe123!
HRMS_ROOT_GROUP_NAME=Root Administrators
LOG_LEVEL=INFO

JWT_ACCESS_TOKEN_TIMEOUT_SECONDS=86400
JWT_REFRESH_TOKEN_TIMEOUT_SECONDS=86400

ENABLE_SWAGGER=True
SWAGGER_REQUIRE_AUTH=True
SWAGGER_SCHEMA_CACHE_TIMEOUT=300

OPENAPI_TITLE=HRMS Dynamic Enterprise Platform API
OPENAPI_DESCRIPTION=A configurable Human Resource Management System where administrators can create and modify business entities entirely from the UI.
OPENAPI_VERSION=1.0.0
OPENAPI_CONTACT_NAME=HRMS API Team
OPENAPI_CONTACT_EMAIL=api-team@example.com
OPENAPI_LICENSE_NAME=Proprietary
OPENAPI_LICENSE_URL=https://example.com/license

